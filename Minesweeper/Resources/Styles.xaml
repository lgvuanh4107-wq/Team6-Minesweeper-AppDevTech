<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 1. HỆ THỐNG MÀU SẮC CHỦ ĐẠO -->
    <SolidColorBrush x:Key="Brush.Background" Color="#D9F2F4"/>
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#26344F"/>
    <SolidColorBrush x:Key="Brush.TextButton" Color="#FFFFFF"/>

    <!-- Màu Xanh lá -->
    <Color x:Key="Color.GreenLight">#A6E86B</Color>
    <Color x:Key="Color.GreenMain">#4CBB4B</Color>
    <SolidColorBrush x:Key="Brush.GreenMain" Color="#4CBB4B"/>
    <SolidColorBrush x:Key="Brush.GreenBorder" Color="#1F7A3E"/>
    <SolidColorBrush x:Key="Brush.GreenShadow" Color="#145A2B"/>

    <!-- Màu Cam vàng -->
    <Color x:Key="Color.OrangeLight">#FFD76A</Color>
    <Color x:Key="Color.OrangeMain">#FFB347</Color>
    <SolidColorBrush x:Key="Brush.OrangeMain" Color="#FFB347"/>
    <SolidColorBrush x:Key="Brush.OrangeBorder" Color="#F2705E"/>
    <SolidColorBrush x:Key="Brush.OrangeShadow" Color="#F2705E"/>

    <!-- Màu Đỏ hồng -->
    <Color x:Key="Color.RedLight">#FF6B93</Color> <!-- Tự tạo một màu sáng hơn cho gradient -->
    <Color x:Key="Color.RedMain">#E8396B</Color>
    <SolidColorBrush x:Key="Brush.RedMain" Color="#E8396B"/>
    <SolidColorBrush x:Key="Brush.RedBorder" Color="#8E1B4A"/>
    <SolidColorBrush x:Key="Brush.RedShadow" Color="#8E1B4A"/>

    <!-- Màu Xanh dương -->
    <Color x:Key="Color.BlueLight">#4FC3F7</Color>
    <Color x:Key="Color.BlueMain">#2A6FD6</Color>
    <SolidColorBrush x:Key="Brush.BlueMain" Color="#2A6FD6"/>
    <SolidColorBrush x:Key="Brush.BlueBorder" Color="#2A6FD6"/>
    <SolidColorBrush x:Key="Brush.BlueShadow" Color="#2A6FD6"/>

    <!-- Ô Cỏ / Ô Đất -->
    <SolidColorBrush x:Key="Brush.CellHidden" Color="#4CBB4B"/>
    <SolidColorBrush x:Key="Brush.CellHiddenBorder" Color="#1F7A3E"/>
    <SolidColorBrush x:Key="Brush.CellRevealed" Color="#FFF8DC"/> <!-- Màu kem -->
    <SolidColorBrush x:Key="Brush.CellRevealedBorder" Color="#E3CB94"/>

    <!-- Các màu chữ số cho ô đất -->
    <SolidColorBrush x:Key="Brush.Number1" Color="#2A6FD6"/>
    <SolidColorBrush x:Key="Brush.Number2" Color="#2E9E4F"/>
    <SolidColorBrush x:Key="Brush.Number3" Color="#E8396B"/>
    <SolidColorBrush x:Key="Brush.Number4" Color="#7B4BC4"/>
    <SolidColorBrush x:Key="Brush.Number5" Color="#E67E22"/>
    <SolidColorBrush x:Key="Brush.Number6" Color="#128C8C"/>
    <SolidColorBrush x:Key="Brush.Number7" Color="#26344F"/>
    <SolidColorBrush x:Key="Brush.Number8" Color="#7A8196"/>

    <SolidColorBrush x:Key="Brush.Mine" Color="#E8396B"/>
    <SolidColorBrush x:Key="Brush.Question" Color="#FFD76A"/>


    <!-- 2. QUY TẮC THIẾT KẾ NÚT BẤM (BUTTON STYLE) -->
    <!-- Base Style cho mọi Button 4 lớp -->
    <Style x:Key="ButtonBaseStyle" TargetType="Button">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextButton}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Lớp 1: Nền bóng/đế dưới cùng (Shadow/Bottom Base) -->
                        <Border x:Name="Shadow" 
                                CornerRadius="14" 
                                Background="{TemplateBinding Tag}"/> <!-- Tag sẽ chứa Brush của bóng -->
                        
                        <!-- Lớp 2: Mặt chính của nút (Face) có chứa Gradient và Viền -->
                        <Border x:Name="Face" 
                                Margin="0,0,0,6" 
                                CornerRadius="14" 
                                BorderThickness="3" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                ClipToBounds="True">
                            
                            <!-- Lớp 3: Hiệu ứng Hover (Lớp phủ trắng mờ) -->
                            <Grid>
                                <Border x:Name="HoverOverlay" Background="#20FFFFFF" Visibility="Collapsed"/>
                                
                                <!-- Lớp 4: Nội dung -->
                                <ContentPresenter Margin="{TemplateBinding Padding}" 
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- FIX LỖI HOVER: Đổi nền mờ bên trong Border đã ClipToBounds -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Face" Property="Margin" Value="0,2,0,4"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="0,6,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Các Style cụ thể kế thừa ButtonBaseStyle -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.GreenBorder}"/>
        <Setter Property="Tag" Value="{StaticResource Brush.GreenShadow}"/> <!-- Tag dùng cho đổ bóng -->
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Color.GreenLight}" Offset="0"/>
                    <GradientStop Color="{StaticResource Color.GreenMain}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.OrangeBorder}"/>
        <Setter Property="Tag" Value="{StaticResource Brush.OrangeShadow}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Color.OrangeLight}" Offset="0"/>
                    <GradientStop Color="{StaticResource Color.OrangeMain}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.RedBorder}"/>
        <Setter Property="Tag" Value="{StaticResource Brush.RedShadow}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Color.RedLight}" Offset="0"/>
                    <GradientStop Color="{StaticResource Color.RedMain}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BlueBorder}"/>
        <Setter Property="Tag" Value="{StaticResource Brush.BlueShadow}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Color.BlueLight}" Offset="0"/>
                    <GradientStop Color="{StaticResource Color.BlueMain}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource BlueButton}">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- 3. ÁP DỤNG THÊM MÀU THEO CHỨC NĂNG -->

    <Style x:Key="CellHidden" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.CellHidden}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.CellHiddenBorder}"/>
        <Setter Property="BorderThickness" Value="2,2,2,4"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <!-- Dấu ? màu vàng nổi bật trên nền cỏ xanh -->
        <Setter Property="Foreground" Value="#FFFF00"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="HoverOverlay" Background="#20FFFFFF" Visibility="Collapsed"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CellRevealed" TargetType="Button">
        <!-- Ô đất màu kem -->
        <Setter Property="Background" Value="{StaticResource Brush.CellRevealed}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.CellRevealedBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Khung CardPanel màu Cam vàng -->
    <Style x:Key="CardPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.OrangeMain}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.OrangeBorder}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <Style x:Key="StatBoxBase" TargetType="Border">
        <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="3,3,3,6"/>
        <Setter Property="Padding" Value="16,0"/>
    </Style>

    <!-- StatBox màu Cam vàng cho hộp thông báo Thắng/Thua, Số mìn -->
    <Style x:Key="StatBoxOrange" TargetType="Border" BasedOn="{StaticResource StatBoxBase}">
        <Setter Property="Background" Value="{StaticResource Brush.OrangeMain}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.OrangeBorder}"/>
    </Style>

    <!-- StatBox màu Xanh dương cho Khung Đồng hồ đếm giờ -->
    <Style x:Key="StatBoxBlue" TargetType="Border" BasedOn="{StaticResource StatBoxBase}">
        <Setter Property="Background" Value="{StaticResource Brush.BlueMain}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BlueBorder}"/>
    </Style>

    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
    </Style>

    <!-- Game ProgressBar -->
    <Style x:Key="GameProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="20"/>
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.GreenMain}"/>
        <Setter Property="Background" Value="#33000000"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10" ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="10"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
