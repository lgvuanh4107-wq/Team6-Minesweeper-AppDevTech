<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


  
    <Color x:Key="Color.GreenLight">#A6E86B</Color>
    <Color x:Key="Color.Green">#4CBB4B</Color>
    <Color x:Key="Color.GreenBorder">#1F7A3E</Color>
    <Color x:Key="Color.GreenBase">#145A2B</Color>
    
    <Color x:Key="Color.YellowLight">#FFD76A</Color>
    <Color x:Key="Color.Orange">#FFB347</Color>
    <Color x:Key="Color.OrangeBorder">#F2705E</Color>
  
    <Color x:Key="Color.Mine">#E8396B</Color>
    <Color x:Key="Color.MineBorder">#8E1B4A</Color>
  
    <Color x:Key="Color.BlueLight">#4FC3F7</Color>
    <Color x:Key="Color.BlueBorder">#2A6FD6</Color>

    <SolidColorBrush x:Key="Brush.GreenBorder"  Color="{StaticResource Color.GreenBorder}"/>
    <SolidColorBrush x:Key="Brush.GreenBase"    Color="{StaticResource Color.GreenBase}"/>
    <SolidColorBrush x:Key="Brush.OrangeBorder" Color="{StaticResource Color.OrangeBorder}"/>
    <SolidColorBrush x:Key="Brush.BlueBorder"   Color="{StaticResource Color.BlueBorder}"/>
    <SolidColorBrush x:Key="Brush.Mine"         Color="{StaticResource Color.Mine}"/>
    <SolidColorBrush x:Key="Brush.MineBorder"   Color="{StaticResource Color.MineBorder}"/>
    <SolidColorBrush x:Key="Brush.Question"     Color="#FFD76A"/>
    <SolidColorBrush x:Key="Brush.Number1" Color="#2A6FD6"/>
    <SolidColorBrush x:Key="Brush.Number2" Color="#2E9E4F"/>
    <SolidColorBrush x:Key="Brush.Number3" Color="#E8396B"/>
    <SolidColorBrush x:Key="Brush.Number4" Color="#7B4BC4"/>
    <SolidColorBrush x:Key="Brush.Number5" Color="#E67E22"/>
    <SolidColorBrush x:Key="Brush.Number6" Color="#128C8C"/>
    <SolidColorBrush x:Key="Brush.Number7" Color="#26344F"/>
    <SolidColorBrush x:Key="Brush.Number8" Color="#7A8196"/>

    <FontFamily x:Key="Font.App">/Resources/Fonts/#Fredoka, Segoe UI</FontFamily>

    
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource Font.App}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    </Style>


    <Style x:Key="CellHidden" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush.Question}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Face"
                                CornerRadius="6"
                                BorderThickness="2"
                                Background="{DynamicResource Brush.CellHidden}"
                                BorderBrush="{DynamicResource Brush.CellHiddenBorder}"/>
                       
                        <Border x:Name="Sheen"
                                CornerRadius="6"
                                IsHitTestVisible="False"
                                Opacity="0.55">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#55FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Sheen" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Sheen" Property="Opacity" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CellRevealed" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="True"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="6"
                                BorderThickness="2"
                                Background="{DynamicResource Brush.CellRevealed}"
                                BorderBrush="{DynamicResource Brush.CellRevealedBorder}"/>
                        <Border CornerRadius="6" IsHitTestVisible="False" Opacity="0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.5"/>
                                    <GradientStop Color="#18000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="CartoonButtonBase" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                      
                        <Border CornerRadius="14"
                                Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Border x:Name="Face"
                                Margin="0,0,0,5"
                                CornerRadius="14"
                                BorderThickness="3"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="0,1,0,4"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="0,4,0,1"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

  
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CartoonButtonBase}">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Tag" Value="{StaticResource Brush.GreenBase}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.GreenBorder}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Color.GreenLight}" Offset="0"/>
                    <GradientStop Color="{StaticResource Color.Green}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource CartoonButtonBase}">
        <Setter Property="Height" Value="48"/>
        <Setter Property="Foreground" Value="#26344F"/>
        <Setter Property="Tag" Value="{StaticResource Brush.OrangeBorder}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.OrangeBorder}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Color.YellowLight}" Offset="0"/>
                    <GradientStop Color="{StaticResource Color.Orange}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource CartoonButtonBase}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Tag" Value="{StaticResource Brush.BlueBorder}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.BlueBorder}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource Color.BlueLight}" Offset="0"/>
                    <GradientStop Color="#3BA6E8" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

   
    <Style x:Key="StatBox" TargetType="Border">
        <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="BorderThickness" Value="3,3,3,5"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush.OrangeBorder}"/>
        <Setter Property="TextElement.FontWeight" Value="Bold"/>
        <Setter Property="TextElement.FontSize" Value="20"/>
        <Setter Property="TextElement.Foreground" Value="#26344F"/>
    </Style>


    <Style x:Key="DifficultyCard" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Padding" Value="8,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card"
                            CornerRadius="14"
                            BorderThickness="3,3,3,5"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource Brush.CellRevealed}"
                            BorderBrush="{DynamicResource Brush.CellRevealedBorder}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.BlueBorder}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Brush.GreenBorder}"/>
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.Surface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

  
    <Style x:Key="TabToggle" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill"
                            CornerRadius="12"
                            BorderThickness="3,3,3,4"
                            Background="{DynamicResource Brush.CellRevealed}"
                            BorderBrush="{DynamicResource Brush.CellRevealedBorder}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush.GreenBorder}"/>
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Brush.GreenBase}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
