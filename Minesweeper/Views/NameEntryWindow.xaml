<Window x:Class="Minesweeper.Views.NameEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dò Mìn" 
        Width="460" 
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource Brush.Background}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Minesweeper" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <TextBox x:Name="TxtPlayerName" Grid.Row="1" Height="35" Margin="0,0,0,10"/>

        <TextBlock x:Name="TxtError" Grid.Row="2" Foreground="Red" Visibility="Collapsed" Margin="0,0,0,10"/>

        <UniformGrid Grid.Row="3" Columns="3" Margin="0,0,0,15">
            <RadioButton x:Name="RadEasy" Content="Dễ" IsChecked="True"/>
            <RadioButton x:Name="RadMedium" Content="Trung bình"/>
            <RadioButton x:Name="RadHard" Content="Khó"/>
        </UniformGrid>

        <StackPanel Grid.Row="4">
            <Button Content="VÀO CHƠI" Click="BtnPlay_Click" Margin="0,0,0,8"/>
            <Button Content="Chơi không lưu điểm" Click="BtnPlayNoSave_Click" Margin="0,0,0,8"/>
            <Button Content="Xếp hạng" Click="BtnLeaderboard_Click"/>
        </StackPanel>
    </Grid>
</Window>