<Window x:Class="Minesweeper.Views.NameEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minesweeper" 
        Width="440" 
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#E0F7FA">

    <Border Margin="15" Background="#FFFFFF" CornerRadius="20" Padding="25">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Logo / Tiêu đề -->
            <TextBlock Text="💣 MINESWEEPER" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="#0277BD" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- Ô nhập tên -->
            <TextBlock Text="Tên người chơi:" FontWeight="SemiBold" Foreground="#455A64" Margin="0,0,0,5"/>
            <Border Background="#F5F5F5" CornerRadius="10" BorderBrush="#B2EBF2" BorderThickness="1.5" Margin="0,0,0,10" Padding="5,2">
                <TextBox x:Name="TxtPlayerName" 
                         BorderThickness="0" 
                         Background="Transparent" 
                         FontSize="15" 
                         Height="30" 
                         VerticalContentAlignment="Center"
                         Padding="5,0"/>
            </Border>

            <!-- Notification error -->
            <TextBlock x:Name="TxtError" Foreground="#E53935" Visibility="Collapsed" Margin="0,0,0,10" FontWeight="Medium" HorizontalAlignment="Center"/>

            <!-- Chọn độ khó -->
            <TextBlock Text="Độ khó:" FontWeight="SemiBold" Foreground="#455A64" Margin="0,5,0,8"/>
            <UniformGrid Columns="3" Margin="0,0,0,20">
                <RadioButton x:Name="RadEasy" Content="Dễ" IsChecked="True" FontWeight="Medium" Foreground="#2E7D32"/>
                <RadioButton x:Name="RadMedium" Content="Trung bình" FontWeight="Medium" Foreground="#EF6C00"/>
                <RadioButton x:Name="RadHard" Content="Khó" FontWeight="Medium" Foreground="#C62828"/>
            </UniformGrid>

            <!-- Nút VÀO CHƠI -->
            <Border CornerRadius="12" Background="#4CAF50" Margin="0,0,0,10">
                <Button Content="VÀO CHƠI" 
                        Click="BtnPlay_Click" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        FontSize="15" 
                        Height="40"
                        Cursor="Hand"/>
            </Border>

            <!-- Nút Chơi không lưu điểm -->
            <Border CornerRadius="12" Background="#FFB74D" Margin="0,0,0,10">
                <Button Content="Chơi không lưu điểm" 
                        Click="BtnPlayNoSave_Click" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Height="38"
                        Cursor="Hand"/>
            </Border>

            <!-- Nút Xếp hạng -->
            <Border CornerRadius="12" Background="#29B6F6">
                <Button Content="Xếp hạng" 
                        Click="BtnLeaderboard_Click" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Height="38"
                        Cursor="Hand"/>
            </Border>
        </StackPanel>
    </Border>
</Window>