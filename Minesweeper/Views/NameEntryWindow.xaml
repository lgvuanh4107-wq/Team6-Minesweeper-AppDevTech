<Window x:Class="Minesweeper.Views.NameEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minesweeper" 
        Width="460" 
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{DynamicResource Brush.Background}">

    <Border Style="{DynamicResource CardPanel}" Margin="24">
        <StackPanel>
            <!-- Logo / Tiêu đề -->
            <TextBlock Text="CỎ VÀ ĐẤT" 
                       Style="{DynamicResource TitleText}"
                       Margin="0,0,0,32"/>

            <!-- Nhập tên -->
            <TextBlock Text="Tên người chơi:" Style="{DynamicResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="{DynamicResource Brush.BlueMain}" BorderThickness="2" Margin="0,0,0,16" Padding="8,4">
                <TextBox x:Name="TxtPlayerName" 
                         BorderThickness="0" 
                         Background="Transparent" 
                         FontSize="16" 
                         Height="36" 
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Foreground="{DynamicResource Brush.TextPrimary}"/>
            </Border>

            <!-- Notification error -->
            <TextBlock x:Name="TxtError" Foreground="{DynamicResource Brush.RedMain}" Visibility="Collapsed" Margin="0,0,0,16" FontWeight="Medium" HorizontalAlignment="Center"/>

            <!-- Chọn độ khó -->
            <TextBlock Text="Độ khó:" Style="{DynamicResource BodyText}" FontWeight="SemiBold" Margin="0,8,0,12"/>
            <UniformGrid Columns="3" Margin="0,0,0,32">
                <RadioButton x:Name="RadEasy" Content="Dễ" IsChecked="True" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.GreenMain}" Padding="8,0" Margin="0,0,8,0"/>
                <RadioButton x:Name="RadMedium" Content="Vừa" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.OrangeMain}" Padding="8,0" Margin="8,0,8,0"/>
                <RadioButton x:Name="RadHard" Content="Khó" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource Brush.RedMain}" Padding="8,0" Margin="8,0,0,0"/>
            </UniformGrid>

            <!-- Nút VÀO CHƠI -->
            <Button Content="VÀO CHƠI" 
                    Style="{DynamicResource PrimaryButton}"
                    Click="BtnPlay_Click" 
                    Margin="0,0,0,16"/>

            <!-- Nút Chơi không lưu điểm -->
            <Button Content="Chơi không lưu điểm" 
                    Style="{DynamicResource SecondaryButton}"
                    Click="BtnPlayNoSave_Click" 
                    Margin="0,0,0,16"/>

            <!-- Nút Xếp hạng -->
            <Button Content="Xếp hạng" 
                    Style="{DynamicResource SecondaryButton}"
                    Click="BtnLeaderboard_Click"/>
        </StackPanel>
    </Border>
</Window>