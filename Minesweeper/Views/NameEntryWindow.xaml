<Window x:Class="Minesweeper.Views.NameEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minesweeper" 
        Width="800" 
        Height="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}">

    <Viewbox Stretch="Uniform">
        <Border Style="{DynamicResource CardPanel}" Margin="24" Width="460">
        <StackPanel>
            <!-- Logo / Tiêu đề -->
            <TextBlock Text="MINESWEEPER" 
                       Style="{DynamicResource TitleText}"
                       FontWeight="Heavy"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       FontFamily="Segoe UI Black"
                       Padding="15"
                       ClipToBounds="False"
                       Margin="0,0,0,32">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A6E86B" Offset="0"/>
                        <GradientStop Color="#4CBB4B" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="2" Color="#26344F" Opacity="1" ShadowDepth="4"/>
                </TextBlock.Effect>
            </TextBlock>

            <!-- Nhập tên -->
            <TextBlock Text="Tên người chơi:" Style="{DynamicResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Background="#FFFFFF" CornerRadius="10" BorderBrush="{DynamicResource Brush.BlueMain}" BorderThickness="2" Margin="0,0,0,16" Padding="8,4">
                <TextBox x:Name="TxtPlayerName" 
                         BorderThickness="0" 
                         Background="Transparent" 
                         FontSize="16" 
                         Height="36" 
                         VerticalContentAlignment="Center"
                         Padding="8,0"
                         Foreground="{DynamicResource Brush.TextPrimary}"/>
            </Border>

            <!-- Notification error -->
            <TextBlock x:Name="TxtError" Foreground="{DynamicResource Brush.RedMain}" Visibility="Collapsed" Margin="0,0,0,16" FontWeight="Medium" HorizontalAlignment="Center"/>

            <!-- Chọn độ khó -->
            <TextBlock Text="Độ khó:" Style="{DynamicResource BodyText}" FontWeight="SemiBold" Margin="0,8,0,12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,32">
                <RadioButton x:Name="RadEasy" Content="Dễ" IsChecked="True" FontWeight="Bold" FontSize="18" Foreground="#26344F" Padding="8,0" Margin="16,0"/>
                <RadioButton x:Name="RadMedium" Content="Trung bình" FontWeight="Bold" FontSize="18" Foreground="#26344F" Padding="8,0" Margin="16,0"/>
                <RadioButton x:Name="RadHard" Content="Khó" FontWeight="Bold" FontSize="18" Foreground="#26344F" Padding="8,0" Margin="16,0"/>
            </StackPanel>

            <!-- Nút VÀO CHƠI -->
            <Button Content="VÀO CHƠI" 
                    Style="{DynamicResource PrimaryButton}"
                    Click="BtnPlay_Click" 
                    Margin="0,0,0,16"/>

            <!-- Nút Chơi không lưu điểm -->
            <Button Content="Chơi không lưu điểm" 
                    Style="{DynamicResource SecondaryButton}"
                    Click="BtnPlayNoSave_Click" 
                    Margin="0,0,0,16"/>

            <!-- Nút Xếp hạng -->
            <Button Content="Xếp hạng" 
                    Style="{DynamicResource SecondaryButton}"
                    Click="BtnLeaderboard_Click"/>
        </StackPanel>
        </Border>
    </Viewbox>
</Window>