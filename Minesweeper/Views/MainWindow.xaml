<Window x:Class="Minesweeper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minesweeper"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}">

    <Grid Margin="24" MinWidth="580">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Thanh trên cùng -->
        <!-- Đã tăng Margin để không dính viền, căn chỉnh các nút thoáng hơn -->
        <Grid Grid.Row="0" Margin="16,0,16,32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Nút về menu -->
                <ColumnDefinition Width="*"/>    <!-- TitleText -->
                <ColumnDefinition Width="Auto"/> <!-- StatBox mìn -->
                <ColumnDefinition Width="Auto"/> <!-- StatBox đồng hồ -->
                <ColumnDefinition Width="Auto"/> <!-- Nút Pause -->
                <ColumnDefinition Width="Auto"/> <!-- Nút restart -->
                <ColumnDefinition Width="Auto"/> <!-- Nút xếp hạng -->
            </Grid.ColumnDefinitions>

            <!-- Nút Đỏ hồng: Đóng cửa sổ, Về menu -->
            <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                    Style="{DynamicResource DangerButton}" ToolTip="Về Menu" Margin="0,0,16,0" Width="48" Click="MenuButton_Click"/>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <Border Background="#4FC3F7" CornerRadius="15" Padding="15,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#2A6FD6" Opacity="0.3" ShadowDepth="3"/>
                    </Border.Effect>
                    <TextBlock x:Name="txtPlayerName" Text="👤 Khách" Style="{DynamicResource TitleText}"
                               FontFamily="Segoe UI Black" FontWeight="Bold" Foreground="White"/>
                </Border>
                <Border Background="White" CornerRadius="15" Padding="15,8" Margin="10,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Color="#4CBB4B" Opacity="0.3" ShadowDepth="3"/>
                    </Border.Effect>
                    <TextBlock x:Name="txtDifficulty" Text="⭐ Dễ 9x9" Style="{DynamicResource TitleText}"
                               FontFamily="Segoe UI Black" FontWeight="Bold" Foreground="#26344F"/>
                </Border>
            </StackPanel>

            <!-- StatBox số mìn (Màu Cam vàng) -->
            <Border Grid.Column="2" Style="{DynamicResource StatBoxOrange}" Margin="16,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.RedMain}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="20"/>
                    <TextBlock x:Name="MineCountTextBlock" Text="10" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- StatBox đồng hồ (Màu Xanh dương) -->
            <Border Grid.Column="3" Style="{DynamicResource StatBoxBlue}" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.TextButton}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="20"/>
                    <TextBlock x:Name="TimerTextBlock" Text="00:00" Foreground="{DynamicResource Brush.TextButton}" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Nút Pause (Màu Xanh dương) -->
            <Button x:Name="PauseButton" Grid.Column="4" Style="{DynamicResource BlueButton}" Width="48" ToolTip="Tạm dừng" Margin="0,0,16,0" Click="PauseButton_Click">
                <TextBlock FontSize="20" FontWeight="Bold" Foreground="White" Text="⏸" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>

            <!-- Nút Restart (Xanh lá, hình chuột chũi) -->
            <Button x:Name="RestartButton" Grid.Column="5" Style="{DynamicResource PrimaryButton}" ToolTip="Chơi lại" Click="RestartButton_Click" Margin="0,0,16,0" Width="48" Padding="4">
                <Image Width="38" Height="38" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="pack://application:,,,/Resources/Images/mole_normal.png"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Win">
                                    <Setter Property="Source" Value="pack://application:,,,/Resources/Images/mole_win.png"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="Lose">
                                    <Setter Property="Source" Value="pack://application:,,,/Resources/Images/mole_lose.png"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Button>

            <!-- Nút Xếp hạng (Cam vàng) -->
            <Button Grid.Column="6" Content="&#xE82D;" FontFamily="Segoe MDL2 Assets"
                    Style="{DynamicResource SecondaryButton}" Width="48" ToolTip="Xếp hạng" Click="LeaderboardButton_Click"/>
        </Grid>

        <!-- Giữa: Bàn cờ + lớp phủ Pause -->
        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="20">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Ô cỏ / Ô đất được quản lý trong BoardGrid qua Style CellHidden và CellRevealed -->
                <!-- Viền bàn cờ dùng CardPanel (Cam vàng) -->
                <Border Style="{DynamicResource CardPanel}" BorderThickness="4" Padding="16">
                    <UniformGrid x:Name="BoardGrid" />
                </Border>

                <Border x:Name="PauseOverlay" Style="{DynamicResource CardPanel}"
                        Background="{DynamicResource Brush.Background}" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Tạm dừng" Style="{DynamicResource TitleText}"
                                   HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <Button x:Name="ResumeButton" Content="Tiếp tục" Style="{DynamicResource PrimaryButton}"
                                HorizontalAlignment="Center" Click="ResumeButton_Click" MinWidth="120"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Viewbox>

        <!-- Dưới: Progress bar và nút âm thanh -->
        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                <TextBlock x:Name="ProgressTextBlock" Text="Dọn bàn cờ 0%" Style="{DynamicResource BodyText}" FontWeight="Bold" Margin="0,0,0,8"/>
                <ProgressBar x:Name="GameProgressBarControl" Style="{DynamicResource GameProgressBar}" Value="0"/>
            </StackPanel>

            <!-- Nút bật/tắt âm thanh (Xanh dương) -->
            <Button Grid.Column="1" Content="&#xE767;" FontFamily="Segoe MDL2 Assets"
                    Style="{DynamicResource BlueButton}" Width="48" Height="48" ToolTip="Bật/Tắt âm thanh" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>