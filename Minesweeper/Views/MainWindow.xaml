<Window x:Class="Minesweeper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minesweeper" 
        SizeToContent="WidthAndHeight" 
        ResizeMode="CanMinimize" 
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}">
    
    <StackPanel Margin="16,24,16,24" MinWidth="560">
        <!-- Thanh trên cùng -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Nút về menu -->
                <ColumnDefinition Width="*"/>    <!-- Khoảng trống / TitleText -->
                <ColumnDefinition Width="Auto"/> <!-- StatBox mìn -->
                <ColumnDefinition Width="Auto"/> <!-- StatBox đồng hồ -->
                <ColumnDefinition Width="Auto"/> <!-- Nút restart -->
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="&#xE72B;" Style="{DynamicResource SecondaryButton}" ToolTip="Về Menu" Margin="0,0,16,0"/>
            
            <TextBlock x:Name="TitleTextBlock" Grid.Column="1" Text="Độ khó: Dễ 9x9 • Phương Linh" Style="{DynamicResource TitleText}" 
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            
            <!-- StatBox số mìn -->
            <Border Grid.Column="2" Style="{DynamicResource StatBox}" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Mine}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="MineCountTextBlock" Text="10" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- StatBox đồng hồ -->
            <Border Grid.Column="3" Style="{DynamicResource StatBox}" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TimerTextBlock" Text="00:00" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <!-- Nút Restart (IconButton) -->
            <Button Grid.Column="4" Content="&#xE72C;" Style="{DynamicResource IconButton}" FontSize="20" ToolTip="Chơi lại"/>
        </Grid>

        <!-- Giữa: Bàn cờ -->
        <Border Style="{DynamicResource CardPanel}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
            <UniformGrid x:Name="BoardGrid" />
        </Border>

        <!-- Dưới: Progress bar và Nút âm thanh -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="ProgressTextBlock" Text="Dọn bàn cờ 0%" Style="{DynamicResource BodyText}" Margin="0,0,0,8"/>
                <ProgressBar x:Name="GameProgressBarControl" Style="{DynamicResource GameProgressBar}" Value="0"/>
            </StackPanel>
            
            <!-- Nút bật/tắt âm thanh -->
            <Button Grid.Column="1" Content="&#xE767;" Style="{DynamicResource IconButton}" ToolTip="Bật/Tắt âm thanh" VerticalAlignment="Center"/>
        </Grid>
    </StackPanel>
</Window>
