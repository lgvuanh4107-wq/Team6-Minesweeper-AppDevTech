<Window x:Class="Minesweeper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Minesweeper"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.TextPrimary}">

    <StackPanel Margin="16,24,16,24" MinWidth="560">
        <!-- Thanh trên cùng -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Nút về menu -->
                <ColumnDefinition Width="*"/>    <!-- TitleText -->
                <ColumnDefinition Width="Auto"/> <!-- StatBox mìn -->
                <ColumnDefinition Width="Auto"/> <!-- StatBox đồng hồ -->
                <ColumnDefinition Width="Auto"/> <!-- Nút Pause -->
                <ColumnDefinition Width="Auto"/> <!-- Nút restart -->
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                    Style="{DynamicResource SecondaryButton}" ToolTip="Về Menu" Margin="0,0,16,0"/>

            <TextBlock x:Name="TitleTextBlock" Grid.Column="1" Text="Độ khó" Style="{DynamicResource TitleText}"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <!-- StatBox số mìn -->
            <Border Grid.Column="2" Style="{DynamicResource StatBox}" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Mine}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="MineCountTextBlock" Text="10" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- StatBox đồng hồ -->
            <Border Grid.Column="3" Style="{DynamicResource StatBox}" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE916;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TimerTextBlock" Text="00:00" Style="{DynamicResource TitleText}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Nút Pause -->
            <Button x:Name="PauseButton" Grid.Column="4" Content="&#xE769;" FontFamily="Segoe MDL2 Assets"
                    Style="{DynamicResource IconButton}" FontSize="20" ToolTip="Tạm dừng"
                    Margin="0,0,16,0" Click="PauseButton_Click"/>

            <!-- Nút Restart -->
            <Button Grid.Column="5" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                    Style="{DynamicResource IconButton}" FontSize="20" ToolTip="Chơi lại"/>
        </Grid>

        <!-- Giữa: Bàn cờ + lớp phủ Pause -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24">
            <Border Style="{DynamicResource CardPanel}">
                <UniformGrid x:Name="BoardGrid" />
            </Border>

            <Border x:Name="PauseOverlay" Style="{DynamicResource CardPanel}"
                    Background="{DynamicResource Brush.Background}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Tạm dừng" Style="{DynamicResource TitleText}"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <Button x:Name="ResumeButton" Content="Tiếp tục" Style="{DynamicResource PrimaryButton}"
                            HorizontalAlignment="Center" Click="ResumeButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dưới: Progress bar và nút âm thanh -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="ProgressTextBlock" Text="Dọn bàn cờ 0%" Style="{DynamicResource BodyText}" Margin="0,0,0,8"/>
                <ProgressBar x:Name="GameProgressBarControl" Style="{DynamicResource GameProgressBar}" Value="0"/>
            </StackPanel>

            <!-- Nút bật/tắt âm thanh -->
            <Button Grid.Column="1" Content="&#xE767;" FontFamily="Segoe MDL2 Assets"
                    Style="{DynamicResource IconButton}" ToolTip="Bật/Tắt âm thanh" VerticalAlignment="Center"/>
        </Grid>
    </StackPanel>
</Window>